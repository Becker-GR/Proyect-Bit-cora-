---
import { Icon } from 'astro-icon/components';
---

<!-- Modal Overlay con pantalla borrosa -->
<div
	id="modal-overlay"
	class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-300 p-4"
>
	<!-- Caja Modal centrada -->
	<div
		id="modal-contenido"
		class="relative w-full max-w-2xl bg-[#0e1726]/95 border border-teal-300 rounded-2xl shadow-2xl p-6 text-white scale-95 transition-transform duration-300 bg-linear-to-br via-cyan-900/40"
	>
		<!-- Cabecera del modal -->
		<div class="flex items-center justify-between pb-3 mb-4 border-b border-teal-300/50">
			<h2 class="font-bold text-lg flex items-center gap-2.5 text-teal-300">
				<Icon name="lucide:brush" class="w-5 h-5 text-teal-300" />
				<span id="modal-titulo">Registro de Mantenimiento</span>
			</h2>
			<button
				type="button"
				id="btn-cerrar-modal"
				class="p-1 rounded-lg text-slate-400 hover:text-teal-300 hover:bg-teal-300/10 transition-colors cursor-pointer"
				title="Cerrar ventana"
			>
				<Icon name="lucide:x" class="w-5 h-5" />
			</button>
		</div>

		<!-- Formulario a dos columnas -->
		<form id="form-editor" class="flex flex-col gap-4">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				
				<!-- Columna 1: Ubicación -->
				<div class="flex flex-col gap-3">
					<span class="text-[11px] font-semibold text-teal-300/80 uppercase tracking-wider">Datos de Ubicación</span>

					<!-- Fecha -->
					<div class="relative">
						<Icon name="lucide:calendar" class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
						<input
							type="date"
							name="fecha"
							class="w-full pl-9 pr-3 py-1.5 text-sm rounded-xl bg-[#0e1727] text-slate-300 border border-teal-300/50 focus:outline-none focus:border-teal-300 cursor-pointer scheme-dark [&::-webkit-calendar-picker-indicator]:cursor-pointer [&::-webkit-calendar-picker-indicator]:opacity-70"
						/>
					</div>

					<!-- Sucursal -->
					<details class="custom-dropdown relative group" data-field="sucursal" data-placeholder="Sucursal">
						<summary class="flex items-center justify-between w-full px-3 py-1.5 text-sm rounded-xl bg-[#0e1726] text-white border border-teal-300/50 hover:border-teal-300 cursor-pointer transition-colors list-none [&::-webkit-details-marker]:hidden select-none">
							<span class="dropdown-label text-slate-300 text-xs">Sucursal</span>
							<Icon name="lucide:chevron-down" class="w-4 h-4 text-teal-300 transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="absolute left-0 right-0 mt-1.5 z-50 bg-[#0e1726] border border-teal-300/50 rounded-xl shadow-xl shadow-black/80 py-1 overflow-hidden backdrop-blur-md max-h-48 overflow-y-auto">
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="209">Suc. 209</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Suc. Constituyentes">Suc. Constituyentes</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Suc. Cedis">Suc. Cedis</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Suc. R. Viejo">Suc. R. Viejo</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Suc. Reg. 99">Suc. Reg. 99</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Suc. AV. Colosio">Suc. AV. Colosio</button>
						</div>
					</details>

					<!-- Área -->
					<details class="custom-dropdown relative group" data-field="area" data-placeholder="Area">
						<summary class="flex items-center justify-between w-full px-3 py-1.5 text-sm rounded-xl bg-[#0e1726] text-white border border-teal-300/50 hover:border-teal-300 cursor-pointer transition-colors list-none [&::-webkit-details-marker]:hidden select-none">
							<span class="dropdown-label text-slate-300 text-xs">Área</span>
							<Icon name="lucide:chevron-down" class="w-4 h-4 text-teal-300 transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="absolute left-0 right-0 mt-1.5 z-50 bg-[#0e1726] border border-teal-300/50 rounded-xl shadow-xl shadow-black/80 py-1 overflow-hidden backdrop-blur-md max-h-48 overflow-y-auto">
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Almacen">Almacen</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Cajas">Cajas</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Contabilidad">Contabilidad</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Flotilla">Flotilla</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Logistica">Logistica</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Mesa de Control">Mesa de Control</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="RRHH">RRHH</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Soporte Tecnico">Soporte Tecnico</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Ventas">Ventas</button>
						</div>
					</details>

					<!-- Trabajador -->
					<div class="relative">
						<Icon name="lucide:user-circle" class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
						<input
							type="text"
							id="input-persona"
							placeholder="Trabajador asignado"
							class="w-full pl-9 pr-3 py-1.5 text-sm rounded-xl bg-[#0e1727] text-white placeholder:text-slate-400 border border-teal-300/50 focus:outline-none focus:border-teal-300"
						/>
					</div>
				</div>

				<!-- Columna 2: Equipo -->
				<div class="flex flex-col gap-3">
					<span class="text-[11px] font-semibold text-teal-300/80 uppercase tracking-wider">Datos del Equipo</span>

					<!-- Tipo de Equipo -->
					<details class="custom-dropdown relative group" data-field="tipoEquipo" data-placeholder="Equipo">
						<summary class="flex items-center justify-between w-full px-3 py-1.5 text-sm rounded-xl bg-[#0e1726] text-white border border-teal-300/50 hover:border-teal-300 cursor-pointer transition-colors list-none [&::-webkit-details-marker]:hidden select-none">
							<span class="dropdown-label text-slate-300 text-xs">Tipo de Equipo</span>
							<Icon name="lucide:chevron-down" class="w-4 h-4 text-teal-300 transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="absolute left-0 right-0 mt-1.5 z-50 bg-[#0e1726] border border-teal-300/50 rounded-xl shadow-xl shadow-black/80 py-1 overflow-hidden backdrop-blur-md">
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Laptop">Laptop</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="PC">PC</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Servidor">Servidor</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Impresora">Impresora</button>
						</div>
					</details>

					<!-- Marca y Modelo -->
					<div class="relative">
						<Icon name="lucide:computer" class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
						<input
							type="text"
							id="input-modelo"
							placeholder="Marca y Modelo"
							class="w-full pl-9 pr-3 py-1.5 text-sm rounded-xl bg-[#0e1727] text-white placeholder:text-slate-400 border border-teal-300/50 focus:outline-none focus:border-teal-300"
						/>
					</div>

					<!-- Número de Serie -->
					<div class="relative">
						<Icon name="lucide:barcode" class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
						<input
							type="text"
							id="input-serie"
							placeholder="Num. de Serie"
							class="w-full pl-9 pr-3 py-1.5 text-sm rounded-xl bg-[#0e1727] text-white placeholder:text-slate-400 border border-teal-300/50 focus:outline-none focus:border-teal-300"
						/>
					</div>

					<!-- Tipo de Servicio -->
					<details class="custom-dropdown relative group" data-field="tipoServicio" data-placeholder="Servicio">
						<summary class="flex items-center justify-between w-full px-3 py-1.5 text-sm rounded-xl bg-[#0e1726] text-white border border-teal-300/50 hover:border-teal-300 cursor-pointer transition-colors list-none [&::-webkit-details-marker]:hidden select-none">
							<span class="dropdown-label text-slate-300 text-xs">Tipo de Servicio</span>
							<Icon name="lucide:chevron-down" class="w-4 h-4 text-teal-300 transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="absolute left-0 right-0 mt-1.5 z-50 bg-[#0e1726] border border-teal-300/50 rounded-xl shadow-xl shadow-black/80 py-1 overflow-hidden backdrop-blur-md">
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Mantenimiento Preventivo">Mantenimiento Preventivo</button>
						</div>
					</details>
				</div>

			</div>

			<!-- Fila inferior: Estatus + Botones Cancelar y Confirmar -->
			<div class="pt-3 border-t border-teal-300/30 flex flex-col sm:flex-row items-center justify-between gap-3 mt-1">
				<div class="w-full sm:w-60">
					<details class="custom-dropdown relative group" data-field="estatus" data-placeholder="Estatus">
						<summary class="flex items-center justify-between w-full px-3 py-1.5 text-sm rounded-xl bg-[#0e1726] text-white border border-teal-300/50 hover:border-teal-300 cursor-pointer transition-colors list-none [&::-webkit-details-marker]:hidden select-none">
							<span class="dropdown-label text-slate-300 text-xs">Estatus</span>
							<Icon name="lucide:chevron-down" class="w-4 h-4 text-teal-300 transition-transform duration-200 group-open:rotate-180" />
						</summary>
						<div class="absolute left-0 right-0 bottom-full mb-1.5 z-50 bg-[#0e1726] border border-teal-300/50 rounded-xl shadow-xl shadow-black/80 py-1 overflow-hidden backdrop-blur-md">
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Concluido">Concluidos</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="En Proceso">En proceso</button>
							<button type="button" class="w-full text-left px-3 py-1.5 text-xs text-slate-200 hover:bg-teal-300/20 hover:text-teal-300 transition-colors cursor-pointer dropdown-option" data-value="Pendiente">Pendiente</button>
						</div>
					</details>
				</div>

				<div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
					<button
						type="button"
						id="btn-cancelar"
						class="font-bold flex items-center gap-1.5 px-4 py-1.5 justify-center rounded-xl bg-slate-800 text-slate-300 hover:text-white hover:bg-slate-700 border border-slate-600/50 cursor-pointer transition-all duration-200 hover:scale-105 active:scale-95 text-xs"
					>
						<Icon name="lucide:x" class="w-4 h-4" />
						<span>Cancelar</span>
					</button>

					<button
						type="button"
						id="btn-confirmar"
						class="font-bold flex items-center gap-1.5 px-5 py-1.5 justify-center rounded-xl bg-teal-300 text-[#0e1726] cursor-pointer transition-transform duration-200 hover:scale-105 active:scale-95 text-xs shadow-lg shadow-teal-300/20"
					>
						<Icon name="lucide:check-circle" class="w-4 h-4 stroke-[2.5]" />
						<span>Confirmar</span>
					</button>
				</div>
			</div>
		</form>
	</div>
</div>

<script>
	// Listas Desplegables

	const allDropdown = document.querySelectorAll<HTMLDetailsElement>('.custom-dropdown');

	allDropdown.forEach((dropdown) => {
		const label = dropdown.querySelector('.dropdown-label');
		const options = dropdown?.querySelectorAll('.dropdown-option');

		options?.forEach((btn) => {
			btn.addEventListener('click', () => {
				const valor = btn.getAttribute('data-value') || btn.textContent?.trim() || '';
				dropdown.dataset.value = valor;

				if (label && btn.textContent) {
					label.textContent = btn.textContent.trim();
					label.classList.remove('text-slate-300', 'text-slate-400', 'font-medium');
					label.classList.add('text-teal-300', 'font-medium');
				}
				dropdown.removeAttribute('open');
			});
		});
	});

	document.addEventListener('click', (e) => {
		if (e.target instanceof Node) {
			allDropdown.forEach((dropdown) => {
				if (!dropdown.contains(e.target as Node)) {
					dropdown.removeAttribute('open');
				}
			});
		}
	});

	// Control del Modal

	const modalOverlay = document.getElementById('modal-overlay');
	const modalContenido = document.getElementById('modal-contenido');
	const modalTitulo = document.getElementById('modal-titulo');
	const btnCerrarModal = document.getElementById('btn-cerrar-modal');
	const formEditor = document.getElementById('form-editor') as HTMLFormElement | null;

	const btnNuevo = document.getElementById('btn-nuevo');
	const btnSeleccionar = document.getElementById('btn-seleccionar');
	const btnCancelar = document.getElementById('btn-cancelar');
	const btnConfirmar = document.getElementById('btn-confirmar');
	const btnEditar = document.getElementById('btn-editar');
	const btnBorrar = document.getElementById('btn-borrar');

	const contenedor = document.getElementById('contenedor-registros');
	let modoSeleccion = false;
	let tarjetaSeleccionada: HTMLElement | null = null;
	let tarjetaEnEdicion: HTMLElement | null = null;

	const abrirModal = (titulo = 'Registro de Mantenimiento') => {
		if (modalTitulo) modalTitulo.textContent = titulo;
		modalOverlay?.classList.remove('opacity-0', 'pointer-events-none');
		modalOverlay?.classList.add('opacity-100');
		modalContenido?.classList.remove('scale-95');
		modalContenido?.classList.add('scale-100');

		const primerInput = formEditor?.querySelector('input');
		setTimeout(() => primerInput?.focus(), 150);
	};

	const cerrarModal = () => {
		modalOverlay?.classList.remove('opacity-100');
		modalOverlay?.classList.add('opacity-0', 'pointer-events-none');
		modalContenido?.classList.remove('scale-100');
		modalContenido?.classList.add('scale-95');
		resetEditor();
	};

	const resetEditor = () => {
		tarjetaEnEdicion = null;
		setModoSeleccion(false);

		formEditor?.querySelectorAll('input').forEach((input) => (input.value = ''));

		allDropdown.forEach((dd) => {
			delete dd.dataset.value;
			dd.removeAttribute('open');
			const label = dd.querySelector('.dropdown-label');
			if (label && dd.dataset.placeholder) {
				label.textContent = dd.dataset.placeholder;
				label.classList.remove('text-teal-300', 'font-medium');
				label.classList.add('text-slate-300');
			}
		});
	};

	const deseleccionarTarjeta = () => {
		if (!tarjetaSeleccionada) return;
		tarjetaSeleccionada.classList.remove('ring-2', 'ring-teal-300', 'border-teal-300', 'bg-[#0e1726]');
		tarjetaSeleccionada = null;
	};

	const setModoSeleccion = (activo: boolean) => {
		modoSeleccion = activo;
		btnSeleccionar?.classList.toggle('ring-2', activo);
		btnSeleccionar?.classList.toggle('ring-white', activo);
		contenedor?.classList.toggle('cursor-pointer', activo);

		if (!activo) deseleccionarTarjeta();
	};

	// Eventos de apertura / cierre

	btnNuevo?.addEventListener('click', () => {
		resetEditor();
		abrirModal('Nuevo Registro');
	});

	btnCancelar?.addEventListener('click', cerrarModal);
	btnCerrarModal?.addEventListener('click', cerrarModal);

	// Cerrar al hacer clic en el fondo borroso (fuera de la tarjeta modal)
	modalOverlay?.addEventListener('click', (e) => {
		if (e.target === modalOverlay) {
			cerrarModal();
		}
	});

	btnSeleccionar?.addEventListener('click', () => {
		setModoSeleccion(!modoSeleccion);
	});

	// Selección de tarjeta en la bitácora
	contenedor?.addEventListener('click', (e) => {
		if (!modoSeleccion) return;

		const tarjeta = (e.target as HTMLElement).closest<HTMLElement>('.tarjeta-registro');
		if (!tarjeta) return;

		if (tarjetaSeleccionada === tarjeta) {
			deseleccionarTarjeta();
			return;
		}

		deseleccionarTarjeta();
		tarjetaSeleccionada = tarjeta;
		tarjetaSeleccionada.classList.add('ring-2', 'ring-teal-300', 'border-teal-300', 'bg-[#0e1726]');
	});

	// Editar tarjeta seleccionada
	const setDropdownVal = (field: string, valor: string) => {
		const dd = document.querySelector<HTMLDetailsElement>(`.custom-dropdown[data-field="${field}"]`);
		if (!dd) return;
		dd.dataset.value = valor;
		const label = dd.querySelector('.dropdown-label');
		if (label) {
			label.textContent = valor;
			label.classList.remove('text-slate-300', 'text-slate-400');
			label.classList.add('text-teal-300', 'font-medium');
		}
	};

	btnEditar?.addEventListener('click', () => {
		if (!tarjetaSeleccionada) {
			alert('Primero haz clic en la tarjeta que quieres editar.');
			return;
		}

		tarjetaEnEdicion = tarjetaSeleccionada;

		const getSlot = (slot: string) =>
			tarjetaEnEdicion?.querySelector(`[data-slot="${slot}"]`)?.textContent?.trim() || '';

		const fechaTexto = getSlot('fecha');
		const fechaInput = document.querySelector<HTMLInputElement>('input[name="fecha"]');
		if (fechaInput && fechaTexto) {
			fechaInput.value = fechaTexto.split('/').reverse().join('-');
		}

		const inputPersona = document.getElementById('input-persona') as HTMLInputElement | null;
		const inputModelo = document.getElementById('input-modelo') as HTMLInputElement | null;
		const inputSerie = document.getElementById('input-serie') as HTMLInputElement | null;

		if (inputPersona) inputPersona.value = getSlot('persona');
		if (inputModelo) inputModelo.value = getSlot('marcaModelo');
		if (inputSerie) inputSerie.value = getSlot('serie');

		setDropdownVal('sucursal', getSlot('sucursal'));
		setDropdownVal('area', getSlot('area'));
		setDropdownVal('tipoEquipo', getSlot('tipoEquipo'));
		setDropdownVal('tipoServicio', getSlot('tipoServicio'));
		setDropdownVal('estatus', getSlot('estatusTexto'));

		abrirModal('Editar Registro');
	});

	// Borrar tarjeta seleccionada
	btnBorrar?.addEventListener('click', () => {
		if (!tarjetaSeleccionada) {
			alert('Primero selecciona la tarjeta que quieres borrar.');
			return;
		}

		if (!confirm('¿Seguro que deseas borrar este registro?')) return;

		const estabaEditandoEsta = tarjetaSeleccionada === tarjetaEnEdicion;
		tarjetaSeleccionada.remove();
		tarjetaSeleccionada = null;

		window.dispatchEvent(new CustomEvent('actualizar-metricas'));

		if (estabaEditandoEsta) {
			cerrarModal();
		} else {
			setModoSeleccion(false);
		}
	});

	// Confirmar registro (Nuevo o Editado)
	const getDropdownVal = (field: string) =>
		document.querySelector<HTMLElement>(`.custom-dropdown[data-field="${field}"]`)?.dataset.value || '';

	btnConfirmar?.addEventListener('click', () => {
		const fechaRaw = document.querySelector<HTMLInputElement>('input[name="fecha"]')?.value || '';
		const fecha = fechaRaw ? fechaRaw.split('-').reverse().join('/') : '';

		const registro = {
			fecha,
			sucursal: getDropdownVal('sucursal'),
			area: getDropdownVal('area'),
			persona: (document.getElementById('input-persona') as HTMLInputElement | null)?.value.trim() || '',
			tipoEquipo: getDropdownVal('tipoEquipo'),
			marcaModelo: (document.getElementById('input-modelo') as HTMLInputElement | null)?.value.trim() || '',
			serie: (document.getElementById('input-serie') as HTMLInputElement | null)?.value.trim() || '',
			tipoServicio: getDropdownVal('tipoServicio'),
			estatus: getDropdownVal('estatus'),
		};

		if (Object.values(registro).some((valor) => !valor)) {
			alert('Por favor completa todos los campos antes de confirmar.');
			return;
		}

		const estilosEstatus: Record<string, { badge: string; dot: string }> = {
			'concluido': {
				badge: 'border-teal-400/40 bg-teal-400/10 text-teal-300',
				dot: 'bg-teal-400'
			},
			'concluidos': {
				badge: 'border-teal-400/40 bg-teal-400/10 text-teal-300',
				dot: 'bg-teal-400'
			},
			'en proceso': {
				badge: 'border-cyan-400/40 bg-cyan-400/10 text-cyan-300',
				dot: 'bg-cyan-400'
			},
			'pendiente': {
				badge: 'border-amber-400/40 bg-amber-400/10 text-amber-300',
				dot: 'bg-amber-400'
			},
			'pendientes': {
				badge: 'border-amber-400/40 bg-amber-400/10 text-amber-300',
				dot: 'bg-amber-400'
			}
		};

		const llenarTarjeta = (objetivo: ParentNode) => {
			const setSlot = (slot: string, texto: string) => {
				const el = objetivo.querySelector(`[data-slot="${slot}"]`);
				if (el) el.textContent = texto;
			};

			setSlot('fecha', registro.fecha);
			setSlot('sucursal', registro.sucursal);
			setSlot('area', registro.area);
			setSlot('persona', registro.persona);
			setSlot('tipoEquipo', registro.tipoEquipo);
			setSlot('marcaModelo', registro.marcaModelo);
			setSlot('serie', registro.serie);
			setSlot('tipoServicio', registro.tipoServicio);
			setSlot('estatusTexto', registro.estatus);

			const estatusKey = registro.estatus.toLowerCase().trim();
			const estilo = estilosEstatus[estatusKey] || estilosEstatus['concluido'];

			const badgeEl = objetivo.querySelector<HTMLElement>('[data-slot="estatusBadge"]');
			const dotEl = objetivo.querySelector<HTMLElement>('[data-slot="estatusDot"]');

			if (badgeEl && dotEl) {
				badgeEl.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-medium border ${estilo.badge}`;
				dotEl.className = `w-1.5 h-1.5 rounded-full ${estilo.dot}`;
			}
		};

		if (tarjetaEnEdicion) {
			llenarTarjeta(tarjetaEnEdicion);
			deseleccionarTarjeta();
		} else {
			const template = document.getElementById('template-registro') as HTMLTemplateElement | null;
			if (template && contenedor) {
				const clone = template.content.cloneNode(true) as DocumentFragment;
				llenarTarjeta(clone);
				contenedor.prepend(clone);
			}
		}

		window.dispatchEvent(new CustomEvent('actualizar-metricas'));
		cerrarModal();
	});
</script>
