---
import { Icon } from "astro-icon/components";
---

<div class="mt-6 2xl:mt-8 flex flex-col gap-2 2xl:gap-3">

	<div class="flex items-center justify-between mb-1 px-1">
		<div class="backdrop-blur-sm border border-teal-300/50 rounded-xl px-3 py-1 2xl:px-3.5 2xl:py-1.5 bg-[#0e1627]/30">
			<h2 class="text-sm 2xl:text-base font-bold text-teal-300">Historial de Mantenimientos</h2>
			<p class="text-xs 2xl:text-sm text-white">Equipos registrados en bitácora</p>
		</div>

		<button
			type="button"
			id="btn-nuevo"
			class="font-bold flex items-center gap-2 px-3.5 py-1.5 2xl:px-4 2xl:py-2 justify-center rounded-2xl bg-teal-300 text-[#0e1726] cursor-pointer transition-transform duration-200 hover:scale-105 active:scale-95 shadow-lg shadow-teal-300/10 text-xs 2xl:text-sm"
		>
			<Icon name="lucide:plus" class="w-4 h-4 stroke-3" />
			<span>Nuevo Registro</span>
		</button>
	</div>

	<div class="grid grid-cols-[90px_1.2fr_1.5fr_1.2fr_125px_75px_75px] 2xl:grid-cols-[110px_1.2fr_1.6fr_1.3fr_140px_85px_85px] gap-4 px-5 py-2 2xl:px-6 2xl:py-3 text-teal-300 text-[14px] 2xl:text-sm font-semibold select-none text-shadow-lg text-shadow-teal-600 border border-teal-300/50 rounded-2xl bg-[#0e1627]/50 shadow-2xl shadow-[#0e1726]">
		<span>Fecha</span>
		<span>Área / Sucursal</span>
		<span>Equipo & Modelo</span>
		<span>Tipo de Servicio</span>
		<span class="text-center">Estatus</span>
		<span class="text-center">Evidencia</span>
		<span class="text-center">Acciones</span>
	</div>

	<div id="contenedor-registros" class="flex flex-col gap-2.5 2xl:gap-3">

			<template id="template-registro">
				<div class="tarjeta-registro grid grid-cols-[90px_1.2fr_1.5fr_1.2fr_125px_75px_75px] 2xl:grid-cols-[110px_1.2fr_1.6fr_1.3fr_140px_85px_85px] gap-4 items-center px-5 py-2 2xl:px-6 2xl:py-3 rounded-2xl border border-teal-300/40 bg-[#0e1727]/50 shadow-lg shadow-black/40 hover:border-teal-300 hover:bg-[#0e1726]/80 transition-all duration-200">
					<div>
						<span data-slot="fecha" class="text-slate-200 font-medium text-sm 2xl:text-sm">07/11/2026</span>
					</div>

					<div class="min-w-0">
						<div class="flex items-center gap-1.5 font-bold text-white text-[13px] 2xl:text-sm">
							<Icon name="lucide:building-2" class="w-3.5 h-3.5 2xl:w-4 2xl:h-4 text-teal-300 shrink-0" />
							<span data-slot="area" class="truncate">Contabilidad</span>
						</div>

						<div class="flex items-center gap-1.5 text-[13px] 2xl:text-xs text-slate-400 mt-0.5">
							<Icon name="lucide:users" class="w-3.5 h-3.5 text-slate-400 shrink-0" />
							<span data-slot="persona" class="truncate">Usuario</span>
						</div>

						<div class="flex items-center gap-1.5 text-[11px] 2xl:text-xs text-slate-400 mt-0.5">
							<Icon name="lucide:map-pin" class="w-3.5 h-3.5 text-slate-400 shrink-0" />
							<span data-slot="sucursal" class="truncate">209</span>
						</div>
					</div>

					<div class="flex items-center gap-2.5 2xl:gap-3 min-w-0">
						<div class="w-8 h-8 2xl:w-10 2xl:h-10 rounded-lg bg-teal-300/10 border border-teal-300/50 flex items-center justify-center shrink-0">
							<Icon name="lucide:monitor" class="w-4 h-4 2xl:w-5 2xl:h-5 text-teal-300" />
						</div>
						
						<div class="overflow-hidden">
							<p data-slot="marcaModelo" class="font-bold text-white text-[13px] 2xl:text-sm truncate">Gigabyte</p>
							
							<div class="flex items-center gap-1.5 text-[11px] 2xl:text-xs text-slate-400 mt-0.5">
								<Icon name="lucide:computer" class="w-3 h-3 2xl:w-3.5 2xl:h-3.5 text-slate-400 shrink-0" />
								<span data-slot="tipoEquipo" class="truncate">PC de Escritorio</span>
							</div>

							<div class="flex items-center gap-1.5 text-[11px] 2xl:text-xs text-slate-400 mt-0.5">
								<Icon name="lucide:barcode" class="w-3.5 h-3.5 text-slate-400 shrink-0" />
								<span class="truncate">S/N <span data-slot="serie" class="text-slate-300">565673</span></span>
							</div>
						</div>
					</div>

					<div class="min-w-0">
						<p data-slot="tipoServicio" class="font-medium text-slate-200 text-[13px] 2xl:text-sm truncate">Mantenimiento Preventivo</p>
						
						
						<p class="text-[11px] 2xl:text-xs text-slate-400 mt-0.5">Téc: Admin TI</p>
					</div>
					
					<div class="flex justify-center">
						<span data-slot="estatusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] 2xl:text-xs font-medium border border-emerald-500/40 bg-emerald-500/10 text-emerald-400">
							<span data-slot="estatusDot" class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
							<span data-slot="estatusTexto">Concluido</span>
						</span>
					</div>

					<div class="flex justify-center">
						<div data-slot="evidencia" class="w-9 h-9 2xl:w-10 2xl:h-10 rounded-lg border border-teal-300/40 bg-teal-950/60 flex items-center justify-center overflow-hidden cursor-pointer hover:border-teal-300 transition-colors shadow-sm">
							<Icon name="lucide:image" class="w-4 h-4 2xl:w-5 2xl:h-5 text-teal-300/80" />
						</div>
					</div>

					<!-- Botones de Acción -->
					<div class="flex items-center justify-center gap-1 2xl:gap-1.5">
						<button
							type="button"
							class="btn-editar-tarjeta p-1.5 rounded-lg text-slate-300 hover:text-teal-300 hover:bg-teal-300/10 transition-colors cursor-pointer"
							title="Editar registro"
						>
							<Icon name="lucide:pencil" class="w-4 h-4 2xl:w-18px 2xl:h-18px" />
						</button>
						<button
							type="button"
							class="btn-borrar-tarjeta p-1.5 rounded-lg text-slate-300 hover:text-rose-400 hover:bg-rose-400/10 transition-colors cursor-pointer"
							title="Eliminar registro"
						>
							<Icon name="lucide:trash" class="w-4 h-4 2xl:w-18px 2xl:h-18px" />
						</button>
					</div>
				</div>
			</template>

	</div>

</div>