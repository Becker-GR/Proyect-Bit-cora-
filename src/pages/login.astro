---
import '../styles/global.css';
import { Icon } from 'astro-icon/components';

const titulo = "Iniciar Sesión | Soporte Técnico";
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
	</head>

	<body class="overflow-x-hidden">
		<div class="bg-linear-to-br bg-[#0e1727] via-cyan-500 text-slate-100 min-h-screen flex items-center justify-center p-4">
			<div class="w-full max-w-md bg-[#0e1726]/40 border border-teal-300/70 rounded-2xl shadow-2xl shadow-black/70 p-6 sm:p-8 backdrop-blur-sm relative overflow-hidden">
				
				<!-- Detalle de luz ambiental decorativo -->
				<div class="absolute -top-24 -left-24 w-50 h-50 bg-teal-400/15 rounded-full blur-3xl pointer-events-none"></div>
				<div class="absolute -bottom-24 -right-24 w-48 h-48 bg-cyan-400/15 rounded-full blur-3xl pointer-events-none"></div>

				<!-- Encabezado -->
				<div class="flex flex-col items-center text-center mb-6 relative z-10">
					<div class="w-12 h-12 rounded-2xl bg-teal-300/10 border border-teal-300/50 flex items-center justify-center text-teal-300 mb-3 shadow-lg shadow-teal-300/10">
						<Icon name="lucide:shield-check" is:inline class="w-6 h-6" />
					</div>
					<h1 class="text-xl font-bold text-teal-300">Bitácora de Soporte</h1>
					<p class="text-[15px] font-semibold text-slate-300 mt-1">Ingresa tus credenciales para acceder</p>
				</div>

				<!-- Alerta de Error (oculta por defecto) -->
				<div id="alerta-error" class="hidden items-center gap-2.5 p-3 mb-4 rounded-xl bg-rose-500/15 border border-rose-400/40 text-rose-300 text-xs relative z-10">
					<Icon name="lucide:alert-circle" is:inline class="w-4 h-4 shrink-0 text-rose-400" />
					<span id="mensaje-error">Usuario o contraseña incorrectos.</span>
				</div>

				<!-- Formulario -->
				<form id="form-login" class="flex flex-col gap-4 relative z-10">
					
					<!-- Campo Usuario -->
					<div class="flex flex-col gap-1.5">
						<label for="input-usuario" class="text-[13px] font-semibold text-slate-300">Usuario</label>
						<div class="relative">
							<Icon name="lucide:user" is:inline class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
							<input
								type="text"
								id="input-usuario"
								name="usuario"
								required
								autocomplete="username"
								placeholder="Ej. guest"
								class="w-full pl-9 pr-3 py-2 text-[13px] rounded-xl bg-[#0e1727]/40 text-white placeholder:text-slate-400 border border-teal-300/50 focus:border-teal-300 focus:outline-none transition-colors"
							/>
						</div>
					</div>

					<!-- Campo Contraseña -->
					<div class="flex flex-col gap-1.5">
						<label for="input-password" class="text-[13px] font-semibold text-slate-300">Contraseña</label>
						<div class="relative">
							<Icon name="lucide:lock" is:inline class="w-4 h-4 text-teal-300 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
							<input
								type="password"
								id="input-password"
								name="password"
								required
								autocomplete="current-password"
								placeholder="••••••••"
								class="w-full pl-9 pr-10 py-2 text-[14px] rounded-xl bg-[#0e1727]/40 text-white placeholder:text-slate-400 border border-teal-300/50 focus:border-teal-300 focus:outline-none transition-colors"
							/>
							<button
								type="button"
								id="btn-toggle-password"
								class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-teal-300 transition-colors p-1 cursor-pointer"
								title="Mostrar/Ocultar contraseña"
							>
								<Icon id="icono-ojo-abierto" name="lucide:eye" is:inline class="w-4 h-4" />
								<Icon id="icono-ojo-cerrado" name="lucide:eye-off" is:inline class="w-4 h-4 hidden" />
							</button>
						</div>
					</div>

					<!-- Botón Entrar -->
					<button
						type="submit"
						id="btn-submit"
						class="mt-2 w-full font-bold flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-teal-300 text-[#0e1726] cursor-pointer transition-transform duration-200 hover:scale-105 active:scale-95 shadow-lg shadow-teal-300/20 text-sm"
					>
						<Icon name="lucide:log-in" is:inline class="w-4 h-4 stroke-[2.5]" />
						<span id="texto-submit">Iniciar Sesión</span>
					</button>

				</form>
			</div>
		</div>

		<!-- Script para interactividad visual (mostrar/ocultar contraseña) -->
		<script>
			const btnToggle = document.getElementById('btn-toggle-password');
			const inputPassword = document.getElementById('input-password') as HTMLInputElement | null;
			const ojoAbierto = document.getElementById('icono-ojo-abierto');
			const ojoCerrado = document.getElementById('icono-ojo-cerrado');

			btnToggle?.addEventListener('click', () => {
				if (!inputPassword) return;
				const esPassword = inputPassword.type === 'password';
				inputPassword.type = esPassword ? 'text' : 'password';
				ojoAbierto?.classList.toggle('hidden', !esPassword);
				ojoCerrado?.classList.toggle('hidden', esPassword);
			});
		</script>
	</body>
</html>
