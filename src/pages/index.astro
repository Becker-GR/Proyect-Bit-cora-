---
import '../styles/global.css';

import SidebarIzquierdo from '../components/SidebarIzquierdo.astro';
import TarjetasMetricas from '../components/TarjetasMetricas.astro';
import SidebarDerecho from '../components/SidebarDerecho.astro';
import TablaBitacora from '../components/TablaBitacora.astro';
import Snackbar from '../components/Snackbar.astro';

const titulo = "Bitácora | Soporte Técnico"
const subtitulo = "Registro & Soporte de Mantenimientos de Stock."
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
	</head>

	<body class="overflow-x-hidden" >
		<div id="layout-wrapper" class="bg-linear-to-br bg-[#0e1727] via-cyan-500 text-slate-100 min-h-screen p-4">
			<SidebarIzquierdo />

			<SidebarDerecho />
			
			<main id="main-content" class="mx-auto w-full max-w-5xl xl:max-w-7xl 2xl:max-w-1520px px-4">
				<header class="border-b border-teal-300/50 pb-1 2xl:pb-2">
					<h1 class="font-bold pb-1 text-center text-[19px] 2xl:text-2xl text-teal-300">{titulo}</h1>
					<p class="font-light text-sm 2xl:text-base text-slate-300 text-center">{subtitulo}</p>
				</header>

				<TarjetasMetricas />

				<TablaBitacora />
			
			</main>

			<Snackbar />
		</div>

	</body>

</html>