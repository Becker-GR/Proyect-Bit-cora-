---
import '../styles/global.css';

import SidebarIzquierdo from '../components/SidebarIzquierdo.astro';
import TarjetasMetricas from '../components/TarjetasMetricas.astro';
import SidebarDerecho from '../components/SidebarDerecho.astro';
import TablaBitacora from '../components/TablaBitacora.astro';

const titulo = "Bitácora | Soporte Técnico"
const subtitulo = "Registro & Soporte de Mantenimientos de Stock."
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
	</head>

	<body>
		<div class="bg-linear-to-br bg-[#0e1727] via-cyan-600 text-slate-100 min-h-screen p-4">
			<SidebarIzquierdo />

			<SidebarDerecho />
			
			<main class="mx-auto max-w-6xl px-4">
				<header class="border-b border-teal-300/50">
					<h1 class="font-bold pb-1 text-center text-[19px] text-teal-300">{titulo}</h1>
					<p class="font-light text-sm text-slate-300 text-center">{subtitulo}</p>
				</header>

				<TarjetasMetricas />

				<TablaBitacora />
			
			</main>
		</div>

	</body>

</html>